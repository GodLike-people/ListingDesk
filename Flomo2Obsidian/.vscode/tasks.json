{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动网页控制台",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "flomo_obsidian.web"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PLAYWRIGHT_BROWSERS_PATH": "${workspaceFolder}\\.ms-playwright"
        }
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "运行测试",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
